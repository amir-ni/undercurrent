# Required: GitHub token used to read public repositories (GraphQL API needs auth even for public data).
# Create a fine-grained token with "Public repositories (read-only)" access and no other scopes:
# https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=

# Optional: enables GET /v1/repos/{owner}/{repo}/narrative (the LLM analyst). Without it that endpoint returns 503.
ANTHROPIC_API_KEY=

# Optional: set to "demo" to run the narrative endpoint without a key, using a deterministic rule engine
# that goes through the same grounding pipeline. It is labeled as not-an-LLM in the API and UI.
# LLM_PROVIDER=demo

# Optional tuning (defaults shown)
# PORT=8787
# HOST=127.0.0.1                   # use 0.0.0.0 inside containers
# DATABASE_PATH=./data/undercurrent.db
# LOG_LEVEL=info                   # debug | info | warn | error
# LLM_MODEL=claude-opus-5-5
# LLM_EFFORT=medium                # low | medium | high | xhigh | max
# SYNC_TTL_SECONDS=900             # how long synced data is considered fresh
# MAX_WINDOW_DAYS=180              # widest period a request may ask for
# MAX_PULL_REQUESTS_PER_SYNC=1000  # upstream safety cap per repository sync (bounds first-sync latency)
# REPO_ALLOWLIST=                  # comma-separated owner/name list; empty = any public repo
# RATE_LIMIT_PER_MINUTE=60         # per client IP, all /v1 routes
# NARRATIVE_RATE_LIMIT_PER_MINUTE=6
# CORS_ORIGINS=                    # comma-separated; empty = same-origin only
